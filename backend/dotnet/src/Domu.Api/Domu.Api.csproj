      <Folder Include="Features\Locations\Infrastructure\Invitations\" />
      <Folder Include="Features\Locations\Infrastructure\Items\" />
      <Folder Include="Features\Locations\Infrastructure\Locations\" />
      <Folder Include="Features\Locations\Infrastructure\Membership\" />
      <Folder Include="Features\Locations\Interface\" />
      <Folder Include="Features\Users\Application\DTOs\" />
      <Folder Include="Features\Users\Application\Ports\" />
      <Folder Include="Features\Users\Infrastructure\" />
      <Folder Include="Infrastructure\Database\Migrations\" />
      <Folder Include="Interface\Shared\" />
