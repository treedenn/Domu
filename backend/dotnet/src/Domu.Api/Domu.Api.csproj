        <Folder Include="Features\Spaces\Application\Spaces\Ports\" />
        <Folder Include="Features\Spaces\Infrastructure\Items\" />
        <Folder Include="Features\Spaces\Infrastructure\Spaces\" />
        <Folder Include="Features\Spaces\Interface\" />
        <Folder Include="Features\Users\Application\Contracts\" />
